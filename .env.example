# ==============================================================================
# PrepNova - Environment Configuration Example
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - NEVER commit sensitive credentials or real API keys to version control.
# - Variables prefixed with VITE_ are exposed to the client-side browser bundle.
# - Non-prefixed variables are strictly SERVER-SIDE ONLY and never exposed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM Configuration (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# AI Studio automatically injects GEMINI_API_KEY at runtime from user secrets.
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL_TEXT="gemini-3.8-flash"
GEMINI_MODEL_TTS="gemini-3.8-flash-lite-tts"

# ------------------------------------------------------------------------------
# 2. Application & Server Configuration (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"
STORAGE_DIR="./data/uploads"

# ------------------------------------------------------------------------------
# 3. Razorpay Payment Gateway (TEST MODE)
# ------------------------------------------------------------------------------
# Server-side keys used for Order creation and HMAC SHA256 Signature Verification:
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourTestKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecretHere"

# ------------------------------------------------------------------------------
# 4. Public Client-Side Environment Variables (Exposed to browser)
# ------------------------------------------------------------------------------
# The public Key ID provided to the Razorpay Checkout modal in the browser:
VITE_RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
VITE_APP_NAME="PrepNova"
VITE_APP_URL="http://localhost:3000"
